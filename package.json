{
  "name": "@chushixixin/dsh-harness-mcp-server",
  "version": "0.9.5",
  "description": "Expose DeepSeek Harness agent capabilities as an MCP server, so an external MCP client (e.g. Hermes) can drive Harness to execute coding tasks. Hermes = brain, Harness = arms.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src",
    "cordis.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "smoke": "npm run build && node smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "mcp",
    "model-context-protocol",
    "cordis",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chushixixin/dsh-harness-mcp-server.git"
  },
  "homepage": "https://github.com/chushixixin/dsh-harness-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/chushixixin/dsh-harness-mcp-server/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-presets": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}